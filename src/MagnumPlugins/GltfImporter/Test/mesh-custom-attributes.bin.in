type = '<'
input = []

# _TBN as bytes, there has to be padding
type += '3bx3bx3bx'
input += [
    1, 2, 3,
    4, 5, 6,
    7, 8, 9
]

# _UV_ROTATION as bytes, again with padding
type += '2bxx2bxx'
input += [
    10, 11,
    12, 13
]

# _TBN_PRECISER as shorts, again padding
type += '3hxx3hxx3hxx'
input += [
    -1, -2, -3,
    -4, -5, -6,
    -7, -8, -9
]

# OBJECT_ID3
type += 'I'
input += [5678125]

# _FANCY_PROPERTY3
type += '4f'
input += [
    0.1, 0.2, 0.3, 0.4
]

# kate: hl python
